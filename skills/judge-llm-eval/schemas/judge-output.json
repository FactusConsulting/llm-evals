{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judge Output (per-run aggregate)",
  "description": "Final aggregated output of /judge for one run. Written to results/<model>/run<N>/judge.json.",
  "type": "object",
  "required": ["model", "run", "judged_at", "chunks", "totals", "agreement"],
  "properties": {
    "model": {
      "type": "string",
      "description": "Model directory name, e.g. gemma4-26b-q6k-458k-turbo4-v2-ai-infer2"
    },
    "run": {
      "type": "integer",
      "description": "Run number"
    },
    "judged_at": {
      "type": "string",
      "format": "date-time"
    },
    "skill_version": {
      "type": "string",
      "description": "Version of judge-llm-eval skill, e.g. 1.0.0"
    },
    "judges": {
      "type": "object",
      "properties": {
        "judge_a": {"type": "string", "description": "Model identifier"},
        "judge_b": {"type": "string"},
        "super_judge": {"type": "string"}
      }
    },
    "chunks": {
      "type": "object",
      "description": "Per-chunk results, keyed by chunk number (1-9)",
      "additionalProperties": {
        "type": "object",
        "required": ["chunk_name", "questions"],
        "properties": {
          "chunk_name": {"type": "string"},
          "reference_available": {"type": "boolean"},
          "questions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["rating", "points", "decided_by"],
              "properties": {
                "rating": {"enum": ["pass", "partial", "fail"]},
                "points": {"type": "integer", "minimum": 0, "maximum": 2},
                "alternative_acceptable": {"type": "boolean"},
                "reference_unavailable": {"type": "boolean"},
                "decided_by": {
                  "enum": ["agreement", "super_judge"],
                  "description": "How the final rating was reached"
                },
                "judge_a": {
                  "type": "object",
                  "properties": {
                    "rating": {"enum": ["pass", "partial", "fail"]},
                    "points": {"type": "integer"},
                    "justification": {"type": "string"}
                  }
                },
                "judge_b": {
                  "type": "object",
                  "properties": {
                    "rating": {"enum": ["pass", "partial", "fail"]},
                    "points": {"type": "integer"},
                    "justification": {"type": "string"}
                  }
                },
                "super_judge": {
                  "type": "object",
                  "properties": {
                    "rating": {"enum": ["pass", "partial", "fail"]},
                    "sided_with": {"enum": ["A", "B", "neither"]},
                    "reasoning": {"type": "string"}
                  }
                }
              }
            }
          },
          "score": {
            "type": "object",
            "properties": {
              "passed": {"type": "integer"},
              "partial": {"type": "integer"},
              "failed": {"type": "integer"},
              "points": {"type": "integer"},
              "max_points": {"type": "integer"},
              "percentage": {"type": "number"}
            }
          }
        }
      }
    },
    "chunk9_breakdown": {
      "type": "object",
      "description": "Special breakdown of chunk 9 by Part A/B/C",
      "properties": {
        "part_a": {"$ref": "#/properties/chunks/additionalProperties/properties/score"},
        "part_b": {"$ref": "#/properties/chunks/additionalProperties/properties/score"},
        "part_c": {"$ref": "#/properties/chunks/additionalProperties/properties/score"}
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "questions_scored": {"type": "integer"},
        "passed": {"type": "integer"},
        "partial": {"type": "integer"},
        "failed": {"type": "integer"},
        "points": {"type": "integer"},
        "max_points": {"type": "integer"},
        "percentage": {"type": "number"}
      }
    },
    "agreement": {
      "type": "object",
      "description": "Inter-rater agreement metrics",
      "properties": {
        "agreement_count": {"type": "integer"},
        "disagreement_count": {"type": "integer"},
        "agreement_pct": {"type": "number"},
        "alternative_acceptable_count": {"type": "integer", "description": "Questions where reference was too narrow but model still scored pass"}
      }
    },
    "notable_errors": {
      "type": "array",
      "description": "Up to 15 most significant factual errors (rating=fail), for the human-readable summary",
      "items": {
        "type": "object",
        "properties": {
          "qid": {"type": "string"},
          "issue": {"type": "string"}
        }
      }
    }
  }
}
