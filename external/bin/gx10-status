#!/usr/bin/env bash
# A compact, read-only status of the gx10 campaign — a dozen lines, no model needed.
set -uo pipefail
REPO="$(cd "$(dirname "$0")/../.." && pwd)"
OUT="$REPO/external/results/gx10-3way"
echo "tid:      $(date '+%m-%d %H:%M')"
if pgrep -f '^bash (.*/)?external/bin/gx10-campaign$' >/dev/null 2>&1; then
  echo "kampagne: KØRER"
elif grep -q 'campaign finished' "$OUT/STATUS" 2>/dev/null; then
  echo "kampagne: FÆRDIG"
else
  echo "kampagne: DØD UDEN AT VÆRE FÆRDIG"
fi
alias_now="$(curl -s --max-time 10 http://192.168.2.173:30000/v1/models 2>/dev/null |
  python3 -c "import json,sys; print(json.load(sys.stdin)['data'][0]['id'])" 2>/dev/null)"
echo "gx10:     ${alias_now:-SVARER IKKE}"
failed="$(find "$OUT" -name '.failed-*' 2>/dev/null | sed "s|$OUT/||" | tr '\n' ' ')"
echo "fejlede:  ${failed:-ingen}"
echo "--- seneste STATUS-linjer"
tail -n 5 "$OUT/STATUS" 2>/dev/null | sed 's/^/  /'
# The step this campaign is on, from STATUS — not merely the newest file on
# disk. A git operation can restamp a finished model's results and make them
# look current.
last_start="$(grep -oE '^[0-9-]+ [0-9:]+  [a-z0-9]+ [a-z0-9-]+: start$' "$OUT/STATUS" 2>/dev/null | tail -1)"
model_key="$(awk '{print $3}' <<<"$last_start")"
step_key="$(awk '{print $4}' <<<"$last_start" | tr -d ':')"
newest=""
[[ -n "$model_key" && -n "$step_key" ]] && newest="$OUT/$model_key/$step_key/results.json"
[[ -f "$newest" ]] || newest="$(find "$OUT" -name results.json -path '*ds4-*' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)"
if [[ -n "$newest" ]]; then
  python3 - "$newest" <<'PY'
import json, sys, os
p = sys.argv[1]; s = json.load(open(p))["summary"]
step = os.path.basename(os.path.dirname(p)); model = os.path.basename(os.path.dirname(os.path.dirname(p)))
total = 92 if s["suite"] == "core" else 50
print(f"--- igangværende/seneste ds4-trin: {model} {step}")
print(f"  {s['total']}/{total} cases, rigtige {s['correct']} ({s['percentage']}%), "
      f"løb tør for budget {s['truncated']}, forced {s.get('forced', 0)}, fejl {s['errors']}")
PY
fi
