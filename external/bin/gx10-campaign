#!/usr/bin/env bash
# Run the full regime against several models on gx10, one model at a time, and
# leave the box on its committed profile afterwards.
#
#   gx10-campaign            run (or resume) the campaign
#   gx10-campaign KEY...     only these models (a model whose block is done
#                            is never swapped in just to be skipped)
#   gx10-campaign status     print what has run so far
#
# Resumable: every step writes a marker when it succeeds, and a rerun skips the
# steps that have one. A failed step is recorded and the campaign moves on — one
# broken suite must not cost the others — except a failed model swap, which skips
# that model's block entirely rather than measuring whatever happens to be loaded.
#
# Model by model, not suite by suite: the three model cards pin three different
# llama.cpp builds, so every swap is a rebuild on the box. Three swaps, not six.
#
# While this runs, gx10 answers the `bigbrain` role with whichever model is
# loaded, and queues behind the eval.
set -uo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
HOMELAB="${HOMELAB:-$HOME/source/homelab}"
HOST="${GX10_URL:-https://gx10-1dd1.lwa.dk}"
OUT="$REPO/external/results/gx10-3way"
STATUS="$OUT/STATUS"
PI_CONFIG="${PI_CONFIG:-$HOME/.pi/agent/models.json}"

# key | model card (homelab) | alias the server answers under | extra ansible vars
#
# DeepSeek runs without its dSpark draft, at 262k on one slot: the card's 1M
# context plus the 10.9 GB draft no longer fits on the current llama.cpp
# master, and the host rebooted twelve times in a row while loading it
# (2026-09-23). The draft changes speed, not the answers; 262k per slot is what
# GLM had, and enough for the 127k budget.
MODELS=(
  "glm|glm5.3-flash-q2kxl-128k-mtp-gb10|glm5.3-flash||UD-Q2_K_XL"
  "dsv4|dsv4-flash-iq3xxs-1m-dspark-gb10|dsv4-flash|llama_cpp_context_size=262144 llama_cpp_parallel_slots=1 llama_cpp_spec_type= llama_cpp_spec_draft_model_id= llama_cpp_spec_draft_model="
  "qwen|qwen3.8-flash-next-q4kxl-512k-mtp-gb10|qwen3.8-flash-next|"
  # IQ2_M with the dSpark draft: the quant that leaves the draft a window.
  "dsv4q2|dsv4-flash-iq2m-1m-dspark-gb10|dsv4-flash-q2|"
  # DeepSeek-V4.1-Flash-1017 UD-IQ1_S, the committed card: no swap to run it.
  "dsv41|dsv41-flash-iq1s-512k-gb10|dsv41-flash|"
  # GLM-5.3-Flash UD-Q4_K_XL across both boxes over RPC (homelab #1074). The
  # head is gx10-59c7, so run with GX10_URL=https://gx10-59c7.lwa.dk. The alias
  # is the Q2 card's, so the fifth field — a substring of the served model_path —
  # is what tells the two apart; this entry never swaps, the two-box model is
  # deployed by llama_cpp_rpc.yaml with both members, not from here.
  "glmq4|glm5.3-flash-q4kxl-mtp-rpc-gb10|glm5.3-flash||UD-Q4_K_XL"
)
# The committed profile; the campaign ends by deploying it without an override.
# Overridable: the two-box model is committed on gx10-59c7, not gx10-1dd1.
RESTORE_ALIAS="${RESTORE_ALIAS:-dsv41-flash}"
# Seeds per ds4 suite. 1 runs each suite once; 2 adds the second seed the
# stability comparison needs.
CAMPAIGN_SEEDS="${CAMPAIGN_SEEDS:-2}"
ONLY=("$@")

DS4_MAX_TOKENS=126976     # the whole slot minus room for the prompt
DS4_TIMEOUT=10800
# No correct answer has needed more than 57k tokens; past that a generation runs
# to the ceiling and ends without an answer. The budget makes the model answer.
DS4_REASONING_BUDGET=65536
TOOL_MAX_TOKENS=32768     # BFCL and tau2: a reasoning model needs more than 8192
LOOP_REASONING_BUDGET=16384  # half of the loop runner's 32768, so the answer has the other half
TAU2_TASKS=20
TAU2_TRIALS=2             # one simulation is 2-10 min on this box

mkdir -p "$OUT"
note() { printf '%s  %s\n' "$(date '+%m-%d %H:%M')" "$*" | tee -a "$STATUS"; }

if [[ "${1:-}" == "status" ]]; then
  [[ -f "$STATUS" ]] && cat "$STATUS" || echo "no campaign has run"
  exit 0
fi

# The fleet key, which gx10 and the router both take. Exported for the runners,
# which read LLAMA_API_KEY; bfcl and tau2 carry it to the eval server on the
# ssh session's stdin, never in a file there.
LLAMA_API_KEY="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['providers']['homelab']['apiKey'])" "$PI_CONFIG")" \
  || { echo "no fleet key in $PI_CONFIG" >&2; exit 1; }
export LLAMA_API_KEY

served_alias() {
  curl -s --max-time 15 -H @<(printf 'Authorization: Bearer %s\n' "$LLAMA_API_KEY") "$HOST/v1/models" 2>/dev/null |
    python3 -c "import json,sys; print(json.load(sys.stdin)['data'][0]['id'])" 2>/dev/null
}

# The GGUF llama-server has loaded, from /props. Two cards can share an alias
# (the GLM Q2 and Q4 profiles both answer as glm5.3-flash), so a block whose
# entry names a quant marker is accepted only when this path carries it.
served_model_path() {
  curl -s --max-time 15 -H @<(printf 'Authorization: Bearer %s\n' "$LLAMA_API_KEY") "$HOST/props" 2>/dev/null |
    python3 -c "import json,sys; print(json.load(sys.stdin).get('model_path',''))" 2>/dev/null
}

# served <alias> [marker]: the endpoint answers as the alias and, where the
# entry names a marker, serves a model_path containing it.
serving() {
  [[ "$(served_alias)" == "$1" ]] || return 1
  [[ -z "${2:-}" || "$(served_model_path)" == *"$2"* ]]
}

# Load a model card on gx10. An extra-var overrides host_vars, so nothing is
# committed per swap; the repo keeps describing the steady state.
ensure_model() {  # <card> <alias> [extra ansible vars, space-separated] [model_path marker]
  local card="$1" alias="$2" vars="${3:-}" marker="${4:-}" extra=() v
  serving "$alias" "$marker" && return 0
  # Same alias, other quant: the swap below deploys one box, which cannot
  # produce the two-box model and would break it where it is running. Refuse
  # rather than record one quant's results under the other's key.
  if [[ -n "$marker" && "$(served_alias)" == "$alias" ]]; then
    note "REFUSED: $alias is served from '$(served_model_path)', not a $marker build — deploy $card first"
    return 1
  fi
  [[ -n "$card" ]] && extra=(-e "active_model_profile=$card")
  for v in $vars; do extra+=(-e "$v"); done
  note "swap -> ${card:-<committed profile>}${vars:+ with $vars} (rebuilds llama.cpp if the pin differs)"
  (cd "$HOMELAB/ansible" && ansible-playbook -i inventory/hosts.yaml \
      playbooks/llm/llama_cpp.yaml --limit gx10-1dd1 "${extra[@]}") \
      > "$OUT/swap-$alias-$(date +%H%M).log" 2>&1
  local i
  for i in $(seq 1 40); do
    serving "$alias" "$marker" && { note "serving $alias${marker:+ ($marker)}"; return 0; }
    sleep 30
  done
  note "SWAP FAILED: expected $alias${marker:+ ($marker)}, server answers '$(served_alias)' from '$(served_model_path)'"
  return 1
}

# run_step <model-key> <step-name> <command...>
run_step() {
  local key="$1" step="$2"; shift 2
  local dir="$OUT/$key" t0 rc
  mkdir -p "$dir"
  if [[ -f "$dir/.done-$step" ]]; then note "$key $step: already done"; return 0; fi
  note "$key $step: start"
  t0=$(date +%s)
  "$@" > "$dir/$step.log" 2>&1; rc=$?
  if [[ $rc -eq 0 ]]; then
    touch "$dir/.done-$step"; rm -f "$dir/.failed-$step"
    note "$key $step: ok ($(( ($(date +%s) - t0) / 60 )) min)"
  else
    touch "$dir/.failed-$step"
    note "$key $step: FAILED exit $rc ($(( ($(date +%s) - t0) / 60 )) min) — see $dir/$step.log"
  fi
  return 0
}

ds4() {  # <key> <alias> <suite> <seed>
  "$REPO/external/ds4-eval/run.py" --url "$HOST" --model "$2" \
    --suite "$3" --mode served --seed "$4" \
    --max-tokens "$DS4_MAX_TOKENS" --timeout "$DS4_TIMEOUT" \
    --reasoning-budget "$DS4_REASONING_BUDGET" \
    --out "$OUT/$1/ds4-$3-seed$4"
}

bfcl() {  # <key> <alias>
  EVAL_OUT="$OUT/$1/bfcl" "$REPO/external/bfcl/run.sh" "$2" "$HOST" \
    --threads 1 --max-tokens "$TOOL_MAX_TOKENS"
}

tau2() {  # <key> <alias>
  TAU2_USER_API_KEY="$LLAMA_API_KEY" EVAL_OUT="$OUT/$1/tau2" \
    "$REPO/external/tau2/run.sh" "$2" "$HOST" \
    --num-tasks "$TAU2_TASKS" --num-trials "$TAU2_TRIALS" \
    --max-concurrency 1 --max-tokens "$TOOL_MAX_TOKENS"
}

loopdet() {  # <key> <alias>
  (cd "$REPO/loop-detection" && ./run-eval.sh --model-url "$HOST" \
      --model-name "gx10-3way-$1-run1" --delay-between 5 \
      --reasoning-budget "$LOOP_REASONING_BUDGET")
}

knowledge() {  # <key> <alias> — one run; judged separately
  local md="$REPO/results/gx10-3way-$1" i rc=0
  mkdir -p "$md/run1"
  ln -sfn ../_archive/gemma4-26b-q6k/chunks "$md/chunks"
  for i in 1 2 3 4 5 6 7 8 9; do
    [[ -s "$md/run1/chunk$i-response.txt" ]] && continue
    "$REPO/run-chunk-validated.sh" "$md"/chunks/chunk"$i"-*.txt \
      "$md/run1/chunk$i-response.txt" "$HOST/v1/chat/completions" "$LLAMA_API_KEY" "$2" || rc=1
  done
  return $rc
}

note "=== campaign start ($(git -C "$REPO" rev-parse --short HEAD)) ==="
for entry in "${MODELS[@]}"; do
  IFS='|' read -r key card alias vars marker <<< "$entry"
  if (( ${#ONLY[@]} )) && [[ " ${ONLY[*]} " != *" $key "* ]]; then continue; fi
  if ! ensure_model "$card" "$alias" "$vars" "$marker"; then
    note "$key: block skipped — the model could not be loaded"
    continue
  fi
  run_step "$key" ds4-core-seed1 ds4 "$key" "$alias" core 1
  run_step "$key" ds4-hard-seed1 ds4 "$key" "$alias" hard 1
  run_step "$key" bfcl           bfcl "$key" "$alias"
  run_step "$key" loop           loopdet "$key" "$alias"
  if (( CAMPAIGN_SEEDS >= 2 )); then
    run_step "$key" ds4-core-seed2 ds4 "$key" "$alias" core 2
    run_step "$key" ds4-hard-seed2 ds4 "$key" "$alias" hard 2
  fi
  run_step "$key" tau2           tau2 "$key" "$alias"
  # GLM and the IQ3_XXS DeepSeek already have knowledge responses in results/;
  # a model without any needs a run generated.
  [[ "$key" == "qwen" || "$key" == "dsv4q2" || "$key" == "dsv41" || "$key" == "glmq4" ]] && run_step "$key" knowledge knowledge "$key" "$alias"
done

ensure_model "" "$RESTORE_ALIAS" || note "RESTORE FAILED — gx10 is not on its committed profile"
note "=== campaign finished ==="
