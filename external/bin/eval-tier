#!/usr/bin/env bash
# Run one tier of benchmarks against a model.
#
#   eval-tier gate <model> <base-url> [api-key]
#   eval-tier rank <model> <base-url> [api-key]
#   eval-tier deep <model> <base-url> [api-key]
#
# The tiers exist because running everything on every model costs days. See
# ../../RUNBOOK.md for what each one is for and when to reach for it.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"
EVAL_ROOT="${EVAL_ROOT:-/opt/evals}"

usage() { sed -n '2,9p' "$0" | sed 's/^#\( \|$\)//'; exit 2; }
[[ $# -lt 3 ]] && usage

TIER="$1"; MODEL="$2"; URL="$3"; KEY="${4:-${LLAMA_API_KEY:-none}}"
STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="$REPO/external/results/$MODEL/$TIER-$STAMP"
mkdir -p "$OUT"

log()  { printf '\n\033[1m== %s\033[0m  %s\n' "$1" "$(date +%H:%M:%S)"; }
skip() { printf '   SKIPPED: %s\n' "$1"; echo "$2: SKIPPED — $1" >> "$OUT/STATUS"; }
done_() { echo "$1: ran" >> "$OUT/STATUS"; }

# A suite that is not installed must say so loudly. Silence here would look
# exactly like a pass, which is the failure mode this file exists to avoid.
have_env() { [[ -x "$EVAL_ROOT/$1/.venv/bin/$1" ]]; }

run_ds4() {
  local suite="$1"
  log "ds4-eval ($suite)"
  if [[ ! -f "$REPO/external/ds4-eval/cases.json" ]]; then
    (cd "$REPO/external/ds4-eval" && ./fetch_cases.py) || { skip "cannot fetch cases" "ds4-$suite"; return; }
  fi
  if "$REPO/external/ds4-eval/run.py" --url "$URL" --model "$MODEL" --api-key "$KEY" \
       --suite "$suite" --out "$OUT/ds4-$suite"; then
    done_ "ds4-$suite"
  else
    skip "run failed" "ds4-$suite"
  fi
}

run_own_knowledge() {
  log "own knowledge suite (1 run)"
  echo "   drive it with skills/judge-llm-eval/HOW-TO-DRIVE-EVAL.md; it needs judges and is not automated here" \
    | tee -a "$OUT/STATUS" >/dev/null
  skip "manual — see skills/judge-llm-eval/HOW-TO-DRIVE-EVAL.md" "knowledge"
}

run_loopdet() {
  log "loop detection (1 pass)"
  if (cd "$REPO/loop-detection" && ./run-eval.sh \
        --model-url "$URL" --model-name "$MODEL-$STAMP" --api-key "$KEY" \
        --delay-between 5); then
    done_ "loop-detection"
  else
    skip "run failed" "loop-detection"
  fi
}

run_tau2() {
  log "tau2-bench"
  have_env tau2 || { skip "not installed — run provision/setup-eval-server.sh" "tau2"; return; }
  "$EVAL_ROOT/tau2/.venv/bin/tau2" --help >/dev/null 2>&1 \
    || { skip "tau2 will not start (CPU baseline? see setup-eval-server.sh)" "tau2"; return; }
  skip "wrapper not written yet — tau2 needs a domain and agent config" "tau2"
}

run_bfcl() {
  log "BFCL"
  have_env bfcl || { skip "not installed — run provision/setup-eval-server.sh" "bfcl"; return; }
  "$EVAL_ROOT/bfcl/.venv/bin/bfcl" --help >/dev/null 2>&1 \
    || { skip "bfcl will not start (CPU baseline? see setup-eval-server.sh)" "bfcl"; return; }
  skip "wrapper not written yet" "bfcl"
}

run_swebench() {
  log "SWE-bench Verified (subset)"
  skip "needs an agent scaffold and more disk than this VM has" "swebench"
}

run_terminalbench() {
  log "Terminal-Bench"
  skip "not installed — needs docker images and an agent scaffold" "terminal-bench"
}

case "$TIER" in
  gate)  run_ds4 core; run_loopdet; run_own_knowledge ;;
  rank)  run_ds4 hard; run_tau2; run_bfcl ;;
  deep)  run_swebench; run_terminalbench ;;
  *)     usage ;;
esac

log "summary"
printf '  %s\n' "$OUT"
[[ -f "$OUT/STATUS" ]] && sed 's/^/  /' "$OUT/STATUS"
