# Installed at /etc/systemd/system/vllm-gx10.service on lars@192.168.2.173.
# Serves the model named in /etc/gx10-vllm.model via /usr/local/bin/gx10-vllm-serve.
# Restart-on-boot managed vLLM 0.24 serving for the GX10 (DGX Spark, sm_121).
[Unit]
Description=vLLM 0.24 model serving on GX10 (managed, model in /etc/gx10-vllm.model)
After=docker.service network-online.target
Requires=docker.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gx10-vllm-serve
ExecStop=/usr/bin/sudo /usr/bin/docker rm -f vllm
[Install]
WantedBy=multi-user.target
