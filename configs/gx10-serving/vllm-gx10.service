# Installed at /etc/systemd/system/vllm-gx10.service on lars@192.168.2.173.
[Unit]
# Boot default is HARDCODED to gemma-26b (FP8-dynamic) — see ExecStart. /etc/gx10-vllm.model
# only records the last manual `gx10-vllm-serve <key>` invocation; it is deliberately NOT
# consulted at boot. Rationale: a session that switches to gemma-26b-bf16 for a test used to
# leave that key persisted, so every later reboot/restart silently came up on the bf16
# rollback at ~24 tok/s instead of FP8's ~41 tok/s — no error, just 40% slower.
# To deviate, run `sudo gx10-vllm-serve gemma-26b-bf16` directly; the next
# `systemctl restart vllm-gx10` (or reboot) returns the box to FP8.
Description=vLLM model serving on GX10 (managed; boot default gemma-26b = FP8-dynamic)
After=docker.service network-online.target
Requires=docker.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gx10-vllm-serve gemma-26b
ExecStop=/usr/bin/sudo /usr/bin/docker rm -f vllm
[Install]
WantedBy=multi-user.target
