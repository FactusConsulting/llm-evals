#!/usr/bin/env bash
# Managed vLLM serving on the GX10 (DGX Spark, sm_121) using the 0.24 image.
# Installed at /usr/local/bin/gx10-vllm-serve on lars@192.168.2.173.
# Usage: gx10-vllm-serve <model-key>   (default: reads /etc/gx10-vllm.model)
# Swap model: `gx10-vllm-serve cohere` (rewrites /etc/gx10-vllm.model + restarts container).
set -uo pipefail
IMG=vllm/vllm-openai:v0.24.0-aarch64-cu129-ubuntu2404
MODEL_KEY="${1:-$(cat /etc/gx10-vllm.model 2>/dev/null || echo glm)}"
COMMON="--ipc=host --gpus all --restart unless-stopped -p 8000:8000 -e HF_HUB_OFFLINE=1 -e OTEL_SERVICE_NAME=vllm-gx10"
OTLP="--otlp-traces-endpoint http://192.168.2.58:4317"
case "$MODEL_KEY" in
  glm)       VOL=/home/lars/models/GLM-4.7-Flash;        ARGS="--served-model-name glm-4.7-flash --dtype bfloat16 --gpu-memory-utilization 0.85 --max-model-len 32768 --max-num-seqs 4 --enable-prefix-caching --trust-remote-code" ;;
  cohere)    VOL=/home/lars/models/North-Mini-Code-1.0;  ARGS="--served-model-name north-mini-code --dtype bfloat16 --gpu-memory-utilization 0.85 --max-model-len 32768 --max-num-seqs 4 --enable-prefix-caching --trust-remote-code" ;;
  gemma-26b) VOL=/home/lars/models/gemma-4-26B-A4B-it;   ARGS="--served-model-name gemma4-26b --dtype bfloat16 --gpu-memory-utilization 0.85 --max-model-len 131072 --max-num-seqs 4 --reasoning-parser gemma4 --enable-auto-tool-choice --tool-call-parser gemma4 --enable-prefix-caching --trust-remote-code" ;;
  qwen-27b)  VOL=/home/lars/models/Qwen3.6-27B-hf;       ARGS="--served-model-name qwen3.6-27b --dtype bfloat16 --gpu-memory-utilization 0.85 --max-model-len 131072 --max-num-seqs 4 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_xml --enable-prefix-caching --trust-remote-code" ;;
  *) echo "unknown model key: $MODEL_KEY (glm|cohere|gemma-26b|qwen-27b)"; exit 2 ;;
esac
echo "[gx10-vllm-serve] serving '$MODEL_KEY' from $VOL"
sudo docker rm -f vllm >/dev/null 2>&1; sleep 5; sync; echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null; sleep 25
echo "$MODEL_KEY" | sudo tee /etc/gx10-vllm.model >/dev/null
exec sudo docker run -d --name vllm $COMMON -v "$VOL":/model:ro $IMG /model $ARGS $OTLP
