# Derived vLLM 0.24 image for Cohere models (North-Mini-Code / Command family).
#
# The stock vllm/vllm-openai:v0.24.0-aarch64-cu129-ubuntu2404 image lists the
# cohere_command3 / cohere_command4 tool parsers but cannot load them: they
# lazy-import `cohere_melody`, which isn't installed, so serving with
# --enable-auto-tool-choice crashes engine init with
#   TypeError: tool_parser:'cohere_command4' which has not been registered
# cohere_melody ships a cp312 manylinux aarch64 wheel, so a one-line add fixes it.
#
# Build on the GX10:
#   docker build -t vllm-gx10:0.24-cohere -f Dockerfile.cohere .
#
# NOTE: the `cohere` key was REMOVED from gx10-vllm-serve when the model zoo was purged
# (it now accepts only gemma-26b | gemma-26b-bf16, and exits 2 on anything else), so this
# image has no managed launcher. Run it by hand, after re-downloading the model:
#   docker rm -f vllm; sync; echo 3 | sudo tee /proc/sys/vm/drop_caches
#   docker run -d --name vllm --ipc=host --gpus all -p 8000:8000 -e HF_HUB_OFFLINE=1 \
#     -v /home/lars/models/North-Mini-Code-1.0:/model:ro vllm-gx10:0.24-cohere /model \
#     --served-model-name north-mini-code --dtype bfloat16 --gpu-memory-utilization 0.85 \
#     --max-model-len 32768 --max-num-seqs 4 --reasoning-parser cohere_command4 \
#     --enable-auto-tool-choice --tool-call-parser cohere_command4 \
#     --enable-prefix-caching --trust-remote-code
FROM vllm/vllm-openai:v0.27.1-aarch64-cu129-ubuntu2404
RUN pip install --no-cache-dir cohere_melody
